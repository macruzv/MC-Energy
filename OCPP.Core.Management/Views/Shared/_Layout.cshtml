@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject OCPP.Core.Database.OCPPCoreContext _db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>ENERGY CORE MC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/material-premium.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div id="app-layout">
        <!-- Top Navigation Bar -->
        <nav id="top-nav">
            <div class="top-nav-container">
                <div class="nav-left">
                    <div class="sidebar-logo">
                        <i class="fas fa-charging-station fa-lg"></i>
                        <span class="d-none d-md-inline">ENERGY CORE MC</span>
                    </div>
                </div>

                <div class="nav-center">
                    <ul class="nav-menu">
                        @if (this.User != null && this.User.Identity != null && this.User.Identity.IsAuthenticated)
                        {
                            var userIdStr = this.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            List<OCPP.Core.Database.Permission> userPermissions = new List<OCPP.Core.Database.Permission>();
                            
                            if (int.TryParse(userIdStr, out int userId))
                            {
                                try 
                                {
                                    userPermissions = _db.UserRoles
                                        .Where(ur => ur.UserId == userId)
                                        .SelectMany(ur => ur.Role.RolePermissions)
                                        .Select(rp => rp.Permission)
                                        .Distinct()
                                        .ToList();
                                }
                                catch (Exception ex)
                                {
                                    // Fallback if DB is temporarily unavailable or schema is changing
                                    System.Diagnostics.Debug.WriteLine($"Menu Error: {ex.Message}");
                                }
                            }

                            // Bypasse for Administrator
                            bool isAdmin = this.User.IsInRole(OCPP.Core.Management.Constants.AdminRoleName);
                            
                            var hasDashboard = isAdmin || userPermissions.Any(p => p.Name == "Dashboard");
                            var hasQuickCharge = isAdmin || userPermissions.Any(p => p.Name == "Carga Rápida");
                            var hasReports = isAdmin || userPermissions.Any(p => p.Name == "Reportes");

                            // Group: Chargers
                            var chargerPerms = isAdmin ? null : userPermissions.Where(p => p.Name == "Cargadores" || p.Name == "Conectores").ToList();
                            
                            // Group: Users
                            var userGroupPerms = isAdmin ? null : userPermissions.Where(p => p.Name == "Usuarios" || p.Name == "Roles y Permisos" || p.Name == "Tarjetas (Tags)").ToList();
                            
                            // Group: Configuration
                            var configPerms = isAdmin ? null : userPermissions.Where(p => p.Name == "Clientes" || p.Name == "Configuración").ToList();

                            if (hasDashboard) {
                                var p = userPermissions.FirstOrDefault(x => x.Name == "Dashboard");
                                string ctrl = p?.Controller ?? "Home";
                                string act = p?.Action ?? "Index";
                                <li class="nav-item">
                                    <a class="nav-link-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == ctrl && ViewContext.RouteData.Values["Action"]?.ToString() == act ? "active" : "")" 
                                       href="~/@ctrl/@(act == "Index" ? "" : act)">
                                        <i class="fas fa-th-large"></i> <span>Dashboard</span>
                                    </a>
                                </li>
                            }

                            if (hasQuickCharge) {
                                var p = userPermissions.FirstOrDefault(x => x.Name == "Carga Rápida");
                                string ctrl = p?.Controller ?? "Home";
                                string act = p?.Action ?? "QuickStart";
                                <li class="nav-item">
                                    <a class="nav-link-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == ctrl && ViewContext.RouteData.Values["Action"]?.ToString() == act ? "active" : "")" 
                                       href="~/@ctrl/@(act == "Index" ? "" : act)">
                                        <i class="fas fa-bolt text-primary-md"></i> <span>Carga Rápida</span>
                                    </a>
                                </li>
                            }

                            if (isAdmin || (chargerPerms != null && chargerPerms.Any())) {
                                <li class="nav-item dropdown">
                                    <a class="nav-link-md dropdown-toggle" href="#" id="chargerDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-plug"></i> <span>Cargadores</span>
                                    </a>
                                    <div class="dropdown-menu glass" aria-labelledby="chargerDropdown">
                                        @if (isAdmin) {
                                            <a class="dropdown-item" href="~/Home/ChargePoint"><i class="fas fa-plug mr-2"></i> Cargadores</a>
                                            <a class="dropdown-item" href="~/Home/Connector"><i class="fas fa-link mr-2"></i> Conectores</a>
                                        } else {
                                            @foreach(var p in chargerPerms.OrderBy(x => x.Name)) {
                                                <a class="dropdown-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == p.Controller && ViewContext.RouteData.Values["Action"]?.ToString() == p.Action ? "active" : "")" 
                                                   href="~/@p.Controller/@(p.Action == "Index" ? "" : (p.Action ?? ""))">
                                                    <i class="fas @(p.Name == "Cargadores" ? "fa-plug" : "fa-link") mr-2"></i> @p.Name
                                                </a>
                                            }
                                        }
                                    </div>
                                </li>
                            }

                            if (hasReports) {
                                var p = userPermissions.FirstOrDefault(x => x.Name == "Reportes");
                                string ctrl = p?.Controller ?? "Home";
                                string act = p?.Action ?? "ChargeReport";
                                <li class="nav-item dropdown">
                                    <a class="nav-link-md dropdown-toggle" href="#" id="reportsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-file-invoice"></i> <span>Reportes</span>
                                    </a>
                                    <div class="dropdown-menu glass" aria-labelledby="reportsDropdown">
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "ChargeReport" ? "active" : "")" href="~/Home/ChargeReport">
                                            <i class="fas fa-chart-bar mr-2"></i> Reporte de Carga
                                        </a>
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "SystemEvents" ? "active" : "")" href="~/Home/SystemEvents">
                                            <i class="fas fa-list-alt mr-2"></i> Eventos y Errores
                                        </a>
                                    </div>
                                </li>
                            }

                            if (isAdmin || (userGroupPerms != null && userGroupPerms.Any())) {
                                <li class="nav-item dropdown">
                                    <a class="nav-link-md dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-users"></i> <span>Usuarios</span>
                                    </a>
                                    <div class="dropdown-menu glass" aria-labelledby="userDropdown">
                                        @if (isAdmin) {
                                            <a class="dropdown-item" href="~/Users/Index"><i class="fas fa-users mr-2"></i> Usuarios</a>
                                            <a class="dropdown-item" href="~/Roles/Index"><i class="fas fa-key mr-2"></i> Roles y Permisos</a>
                                            <a class="dropdown-item" href="~/Home/ChargeTag"><i class="fas fa-id-card mr-2"></i> Tarjetas (Tags)</a>
                                        } else {
                                            @foreach(var p in userGroupPerms.OrderBy(x => x.Name)) {
                                                <a class="dropdown-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == p.Controller && ViewContext.RouteData.Values["Action"]?.ToString() == p.Action ? "active" : "")" 
                                                   href="~/@p.Controller/@(p.Action == "Index" ? "" : (p.Action ?? ""))">
                                                    <i class="fas @(p.Name switch {
                                                        "Usuarios" => "fa-users",
                                                        "Roles y Permisos" => "fa-key",
                                                        "Tarjetas (Tags)" => "fa-id-card",
                                                        _ => "fa-circle"
                                                    }) mr-2"></i> @p.Name
                                                </a>
                                            }
                                        }
                                    </div>
                                </li>
                            }

                            if (isAdmin || (configPerms != null && configPerms.Any())) {
                                <li class="nav-item dropdown">
                                    <a class="nav-link-md dropdown-toggle" href="#" id="configDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-cogs"></i> <span>Configuración</span>
                                    </a>
                                    <div class="dropdown-menu glass" aria-labelledby="configDropdown">
                                        @if (isAdmin) {
                                            <a class="dropdown-item" href="~/Customers/Index"><i class="fas fa-address-book mr-2"></i> Clientes</a>
                                            <a class="dropdown-item" href="~/Settings/Index"><i class="fas fa-cogs mr-2"></i> Configuración</a>
                                        } else {
                                            @foreach(var p in configPerms.OrderBy(x => x.Name)) {
                                                <a class="dropdown-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == p.Controller && ViewContext.RouteData.Values["Action"]?.ToString() == p.Action ? "active" : "")" 
                                                   href="~/@p.Controller/@(p.Action == "Index" ? "" : (p.Action ?? ""))">
                                                    <i class="fas @(p.Name == "Clientes" ? "fa-address-book" : "fa-cogs") mr-2"></i> @p.Name
                                                </a>
                                            }
                                        }
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>

                <div class="nav-right">
                    @if (this.User != null && this.User.Identity != null && this.User.Identity.IsAuthenticated)
                    {
                        <div class="user-profile glass mr-3">
                            <span class="mr-2 d-none d-lg-inline">@this.User.Identity.Name</span>
                            <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="fas fa-user-circle"></i>
                            </div>
                        </div>
                        <a class="nav-link-md logout-btn" href="~/Account/Logout" title="@Localizer["Logout"]">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    }
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div id="main-container">
            <header class="content-header p-0 mb-4">
                <div class="header-title">
                    <span class="text-muted small">@Localizer["Management"]</span>
                    <h1 class="h2">@ViewData["Title"]</h1>
                </div>
            </header>

            <main role="main">
                @RenderBody()
            </main>

            <footer class="mt-5 text-muted small">
                Energy.Core Management @string.Format("V{0}", System.Reflection.Assembly.GetExecutingAssembly().GetName().Version.ToString(3))
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.es.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

