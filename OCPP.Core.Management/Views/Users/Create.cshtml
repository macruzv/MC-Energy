@model OCPP.Core.Database.User
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark-light border-0 rounded-lg shadow-lg">
                <div class="card-body p-4">
                    <h3 class="text-white mb-4">Crear Nuevo Usuario</h3>
                    <form asp-action="Create" method="post">
                        <div class="form-group mb-3">
                            <label class="text-muted small uppercase font-weight-bold">Nombre de Usuario</label>
                            <input asp-for="Username" class="form-control bg-dark border-0 text-white" placeholder="ej: jsmith" required>
                        </div>
                        <div class="form-group mb-3">
                            <label class="text-muted small uppercase font-weight-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control bg-dark border-0 text-white" placeholder="ej: usuario@empresa.com">
                        </div>
                        <div class="form-group mb-3">
                            <label class="text-muted small uppercase font-weight-bold">Contraseña</label>
                            <input asp-for="PasswordHash" type="password" class="form-control bg-dark border-0 text-white" placeholder="Mínimo 6 caracteres" required>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label class="text-muted small uppercase font-weight-bold mb-2 d-block">Roles Asignados</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var role in (List<OCPP.Core.Database.Role>)ViewBag.Roles)
                                {
                                    <div class="custom-control custom-checkbox mr-3">
                                        <input type="checkbox" name="selectedRoles" value="@role.RoleId" class="custom-control-input" id="role_@role.RoleId">
                                        <label class="custom-control-label text-white" for="role_@role.RoleId">@role.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary-md flex-grow-1 py-2">
                                <i class="fas fa-user-plus mr-2"></i>Crear Cuenta
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light py-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
