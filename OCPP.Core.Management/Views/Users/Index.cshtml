@model IEnumerable<OCPP.Core.Database.User>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white font-weight-bold">
            <i class="fas fa-users-cog mr-2 text-primary-md"></i>Gestión de Usuarios
        </h2>
        <a asp-action="Create" class="btn btn-primary-md px-4 py-2 rounded-pill">
            <i class="fas fa-plus mr-2"></i>Nuevo Usuario
        </a>
    </div>

    <div class="card bg-dark-light border-0 rounded-lg shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead class="bg-primary-soft">
                        <tr class="text-muted small uppercase font-weight-bold">
                            <th class="border-0 px-4 py-3">Usuario</th>
                            <th class="border-0 px-4 py-3">Email</th>
                            <th class="border-0 px-4 py-3">Roles</th>
                            <th class="border-0 px-4 py-3">Cargadores</th>
                            <th class="border-0 px-4 py-3">Estado</th>
                            <th class="border-0 px-4 py-3 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isAdmin = item.UserRoles.Any(ur => ur.Role.Name == "Administrador");
                            <tr>
                                <td class="px-4 py-3 border-0">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle mr-3">@item.Username.Substring(0, 1).ToUpper()</div>
                                        <span class="font-weight-bold">@item.Username</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 border-0 text-muted">@item.Email</td>
                                <td class="px-4 py-3 border-0">
                                    @foreach (var ur in item.UserRoles)
                                    {
                                        <span class="badge badge-pill badge-outline-primary mr-1">@ur.Role.Name</span>
                                    }
                                </td>
                                <td class="px-4 py-3 border-0">
                                    @if (isAdmin)
                                    {
                                        <span class="badge badge-pill badge-info">Todos</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pill @(item.UserChargePoints.Count > 0 ? "badge-primary" : "badge-secondary")">
                                            @item.UserChargePoints.Count
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 border-0">
                                    @if(item.IsActive) {
                                        <span class="text-success"><i class="fas fa-check-circle mr-1"></i>Activo</span>
                                    } else {
                                        <span class="text-danger"><i class="fas fa-times-circle mr-1"></i>Inactivo</span>
                                    }
                                </td>
                                <td class="px-4 py-3 border-0 text-right">
                                    <a asp-action="Assignments" asp-route-id="@item.UserId" class="btn btn-info-soft btn-sm mr-2" title="Asignar Cargadores">
                                        <i class="fas fa-plug"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.UserId" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este usuario?')">
                                        <button type="submit" class="btn btn-danger-soft btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 35px;
        height: 35px;
        background: var(--primary-md);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
    }
    .badge-outline-primary {
        border: 1px solid var(--primary-md);
        color: var(--primary-md);
        background: transparent;
    }
    .btn-info-soft {
        background: rgba(23, 162, 184, 0.1);
        color: #17a2b8;
        border: none;
    }
    .btn-danger-soft {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        border: none;
    }
</style>
