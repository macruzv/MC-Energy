@model IEnumerable<OCPP.Core.Database.Customer>
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white font-weight-bold">
            <i class="fas fa-address-book mr-2 text-primary-md"></i>Gestión de Clientes
        </h2>
        <a asp-action="Create" class="btn btn-primary-md px-4 py-2 rounded-pill">
            <i class="fas fa-plus mr-2"></i>Nuevo Cliente
        </a>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="glass-panel p-4 mb-4" style="border-radius: 20px;">
        <form asp-action="Index" method="get" class="row align-items-end">
            <div class="col-md-4">
                <label class="small text-muted font-weight-bold mb-2">BUSCAR POR NOMBRE</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-subtle text-muted rounded-left-pill px-3">
                            <i class="fas fa-user"></i>
                        </span>
                    </div>
                    <input type="text" name="name" value="@ViewBag.SearchName" class="form-control bg-transparent text-white border-subtle rounded-right-pill px-3" placeholder="Ej: Juan Pérez">
                </div>
            </div>
            <div class="col-md-4">
                <label class="small text-muted font-weight-bold mb-2">BUSCAR POR TELÉFONO</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-subtle text-muted rounded-left-pill px-3">
                            <i class="fas fa-phone"></i>
                        </span>
                    </div>
                    <input type="text" name="phone" value="@ViewBag.SearchPhone" class="form-control bg-transparent text-white border-subtle rounded-right-pill px-3" placeholder="Ej: (809) 000-0000">
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary-md rounded-pill px-4 flex-grow-1">
                    <i class="fas fa-search mr-2"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </form>
    </div>

    <div class="card bg-dark-light border-0 rounded-lg shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead class="bg-primary-soft">
                        <tr class="text-muted small uppercase font-weight-bold">
                            <th class="border-0 px-4 py-3">Cliente</th>
                            <th class="border-0 px-4 py-3">Cédula</th>
                            <th class="border-0 px-4 py-3">Contacto</th>
                            <th class="border-0 px-4 py-3">RFIDs Vinculados</th>
                            <th class="border-0 px-4 py-3 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 border-0">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle mr-3">@item.Name.Substring(0, 1).ToUpper()</div>
                                        <div class="d-flex flex-column">
                                            <span class="font-weight-bold">@item.Name</span>
                                            <small class="text-muted">ID: #@item.CustomerId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3 border-0">@item.Identifier</td>
                                <td class="px-4 py-3 border-0">
                                    <div class="d-flex flex-column small">
                                        <span><i class="fas fa-phone mr-1"></i> @item.Phone</span>
                                        <span class="text-muted"><i class="fas fa-envelope mr-1"></i> @item.Email</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 border-0">
                                    @if(item.ChargeTags != null && item.ChargeTags.Any()) {
                                        @foreach (var tag in item.ChargeTags)
                                        {
                                            <span class="badge badge-pill badge-outline-info mr-1" title="@tag.TagId">
                                                <i class="fas fa-id-card mr-1"></i> @(string.IsNullOrEmpty(tag.TagName) ? tag.TagId : tag.TagName)
                                            </span>
                                        }
                                    } else {
                                        <span class="text-warning small italic">Sin tarjeta asignada</span>
                                    }
                                </td>
                                <td class="px-4 py-3 border-0 text-right">
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-primary-soft btn-sm mr-2">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este cliente?')">
                                        <button type="submit" class="btn btn-danger-soft btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--primary-md) 0%, #a88dff 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    .badge-outline-info {
        border: 1px solid #17a2b8;
        color: #17a2b8;
        background: rgba(23, 162, 184, 0.05);
    }
    .btn-primary-soft {
        background: rgba(208, 188, 255, 0.1);
        color: var(--primary-md);
        border: none;
    }
    .btn-danger-soft {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        border: none;
    }
    .bg-primary-soft {
        background: rgba(208, 188, 255, 0.05);
    }
    .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .border-subtle {
        border-color: rgba(255,255,255,0.1) !important;
    }
    .rounded-left-pill {
        border-top-left-radius: 50rem !important;
        border-bottom-left-radius: 50rem !important;
    }
    .rounded-right-pill {
        border-top-right-radius: 50rem !important;
        border-bottom-right-radius: 50rem !important;
    }
    .input-group-text {
        border-right: none !important;
    }
    .form-control:focus {
        background: rgba(255,255,255,0.05) !important;
        box-shadow: none;
        border-color: var(--primary-md) !important;
    }
    .gap-2 { gap: 0.5rem; }
    .flex-grow-1 { flex-grow: 1; }
    .italic { font-style: italic; }
</style>
