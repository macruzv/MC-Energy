@model OCPP.Core.Database.Customer
@{
    ViewData["Title"] = "Nuevo Cliente";
    var availableTags = ViewBag.AvailableTags as IEnumerable<OCPP.Core.Database.ChargeTag>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-panel p-5" style="border-radius: 32px;">
                <h2 class="text-white font-weight-bold mb-4">
                    <i class="fas fa-user-plus mr-2 text-primary-md"></i>Registrar Nuevo Cliente
                </h2>

                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <label class="small text-muted font-weight-bold mb-2">NOMBRE COMPLETO</label>
                            <input asp-for="Name" class="form-control bg-transparent text-white border-subtle rounded-pill px-4" placeholder="Ej: Juan Pérez" required>
                        </div>
                        
                        <div class="col-md-6 mb-4">
                            <label class="small text-muted font-weight-bold mb-2">CÉDULA / IDENTIFICACIÓN</label>
                            <input asp-for="Identifier" class="form-control bg-transparent text-white border-subtle rounded-pill px-4" placeholder="000-0000000-0" id="cust-id">
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="small text-muted font-weight-bold mb-2">TELÉFONO</label>
                            <input asp-for="Phone" class="form-control bg-transparent text-white border-subtle rounded-pill px-4" placeholder="(000) 000-0000" id="cust-tel">
                        </div>

                        <div class="col-md-12 mb-4">
                            <label class="small text-muted font-weight-bold mb-2">CORREO ELECTRÓNICO</label>
                            <input asp-for="Email" type="email" class="form-control bg-transparent text-white border-subtle rounded-pill px-4" placeholder="cliente@correo.com">
                        </div>

                        <!-- RFID Selection -->
                        <div class="col-md-12 mb-4">
                            <label class="small text-muted font-weight-bold mb-2 d-block">VINCULAR TARJETAS RFID (OPCIONAL)</label>
                            <div class="card bg-dark-soft border-subtle rounded-lg p-3" style="max-height: 200px; overflow-y: auto;">
                                @if (availableTags != null && availableTags.Any())
                                {
                                    @foreach (var tag in availableTags)
                                    {
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input type="checkbox" class="custom-control-input" id="tag-@tag.TagId" name="selectedTags" value="@tag.TagId">
                                            <label class="custom-control-label text-white" for="tag-@tag.TagId">
                                                <span class="font-weight-bold">@tag.TagId</span> - 
                                                <span class="text-muted small">@(tag.TagName ?? "Sin Nombre")</span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted">
                                        <i class="fas fa-info-circle mr-1"></i> No hay tarjetas RFID disponibles para vincular.
                                    </div>
                                }
                            </div>
                            <small class="text-muted mt-2 d-block">* Solo se muestran tarjetas activas que no están vinculadas a otro cliente.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-5 mr-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary-md rounded-pill px-5">
                            <i class="fas fa-save mr-2"></i>Guardar Cliente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }
    .border-subtle {
        border-color: rgba(255,255,255,0.1) !important;
    }
    .bg-dark-soft {
        background: rgba(0,0,0,0.2);
    }
    .custom-control-input:checked ~ .custom-control-label::before {
        background-color: var(--primary-md);
        border-color: var(--primary-md);
    }
</style>

@section Scripts {
    <script>
        // Apply masks if needed (reusing logic from QuickStart)
        function applyMask(id, maskFunc) {
            const el = document.getElementById(id);
            if (el) el.oninput = function() { maskFunc(this); };
        }

        applyMask('cust-id', function(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 11) value = value.slice(0, 11);
            let formatted = '';
            if (value.length > 0) {
                formatted = value.slice(0, 3);
                if (value.length > 3) {
                    formatted += '-' + value.slice(3, 10);
                    if (value.length > 10) formatted += '-' + value.slice(10, 11);
                }
            }
            input.value = formatted;
        });

        applyMask('cust-tel', function(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 10) value = value.slice(0, 10);
            let formatted = '';
            if (value.length > 0) {
                formatted = '(' + value.slice(0, 3);
                if (value.length > 3) {
                    formatted += ') ' + value.slice(3, 6);
                    if (value.length > 6) formatted += '-' + value.slice(6, 10);
                }
            }
            input.value = formatted;
        });
    </script>
}
