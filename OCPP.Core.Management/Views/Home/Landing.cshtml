@{
    ViewData["Title"] = ""; // Empty title to avoid default header text
    Layout = "_Layout";
}

<style>
    /* Reset container padding to allow full bleed */
    .container-fluid, .container {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
    }

    /* Main wrapper */
    .landing-wrapper {
        position: fixed; /* Fixed to cover everything */
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/img/landing-bg-final.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: flex-end; /* Cards at bottom */
        padding-bottom: 50px;
        z-index: 100; /* Lower z-index so navbar (usually 1030) stays on top */
    }

    /* Rest of the styles remain similar */
    .landing-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 40px;
    }

    .landing-title {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 700;
        font-size: 3.5rem;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 2px;
        /* Crisp text with outer glow (behind effect) */
        text-shadow: 
            0 0 2px #fff,                /* Sharp white edge */
            0 0 10px rgba(0, 255, 136, 0.8), /* Inner green halo */
            0 0 30px rgba(0, 255, 136, 0.6), /* Outer glow */
            0 0 50px rgba(0, 255, 136, 0.4); /* Atmospheric glow */
        margin-bottom: 2rem;
        text-align: center;
        /* Position handled in inline style or flow for responsiveness */
        width: 100%;
    }

    .cards-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 40px;
    }

    .landing-card {
        background: rgba(18, 18, 18, 0.7);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 25px;
        width: 320px;
        height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }

    .landing-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
        opacity: 0.5;
    }

    .landing-card:hover {
        transform: translateY(-5px);
        background: rgba(18, 18, 18, 0.85);
        border-color: var(--accent-color);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 15px var(--glow-color);
        text-decoration: none;
    }

    .landing-card .icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
        color: var(--accent-color);
        text-shadow: 0 0 10px var(--glow-color);
    }

    .landing-card .title {
        font-size: 1.2rem;
        color: #fff;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .landing-card .action-btn {
        display: inline-block;
        padding: 8px 20px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 20px;
        color: #aaa;
        font-size: 0.9rem;
        transition: all 0.2s;
        text-align: center;
        width: fit-content;
    }

    .landing-card:hover .action-btn {
        background: var(--accent-color);
        color: #000;
        border-color: var(--accent-color);
        font-weight: 600;
    }

    /* Card Variants */
    .card-charge {
        --accent-color: #00ff88; /* Neon Green */
        --glow-color: rgba(0, 255, 136, 0.4);
    }

    .card-stats {
        --accent-color: #bb86fc; /* Purple */
        --glow-color: rgba(187, 134, 252, 0.4);
    }

    .card-support {
        --accent-color: #00d9ff; /* Cyan */
        --glow-color: rgba(0, 217, 255, 0.4);
    }
    
    /* Stats preview in card */
    .stats-graph {
        height: 40px;
        width: 100%;
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 20" preserveAspectRatio="none"><path d="M0,20 L0,15 C10,18 20,5 30,10 S50,0 60,12 S80,18 90,10 L100,8 L100,20 Z" fill="rgba(187, 134, 252, 0.2)" stroke="%23bb86fc" stroke-width="1" fill-opacity="0.5"/></svg>');
        background-size: cover;
        border-radius: 5px;
        margin-top: auto;
    }
</style>

<div class="landing-wrapper">
    

    <div class="landing-content">
        <!-- Title positioned just above cards -->
        <h1 class="landing-title" style="position: relative; top: auto; left: auto; margin-bottom: 30px; margin-top: 20px;">ENERGY CORE MC</h1>
        <div class="cards-container">
            <!-- Charge Now -->
            <a href="@Url.Action("QuickStart", "Home")" class="landing-card card-charge">
                <div class="icon"><i class="fas fa-plug"></i></div>
                <div>
                    <div class="title">Charge Now</div>
                    <div class="action-btn">Start Charging</div>
                </div>
            </a>

            <!-- My Statistics -->
            <a href="@Url.Action("Transactions", "Home")" class="landing-card card-stats">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="title">Mis Transacciones</div>
                    <i class="fas fa-chart-line text-white"></i>
                </div>
                <div class="stats-graph"></div>
                <div class="d-flex justify-content-between align-items-end mt-2">
                    <div class="small text-muted"><i class="fas fa-bolt mr-1"></i>1,203 kW</div>
                    <div class="small text-muted">Data view</div>
                </div>
            </a>

            <!-- Support -->
            <a href="@Url.Action("Diagnostics", "Home")" class="landing-card card-support">
                <div class="icon"><i class="fas fa-headset"></i></div>
                <div>
                    <div class="title">Support</div>
                    <div class="action-btn">Contact</div>
                </div>
            </a>
        </div>
    </div>
</div>
