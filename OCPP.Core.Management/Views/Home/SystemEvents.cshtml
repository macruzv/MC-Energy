@using Microsoft.AspNetCore.Mvc.Localization
@model OCPP.Core.Management.Models.SystemEventsViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Reporte de Eventos y Errores";
}

<div class="mb-4">
    <a href="~/" class="text-muted small"><i class="fas fa-home"></i> Dashboard</a>
    <span class="mx-2 text-muted">/</span>
    <span class="small font-weight-bold">Reportes</span>
    <span class="mx-2 text-muted">/</span>
    <span class="small font-weight-bold">System Events & Errors</span>
</div>

<!-- Filters -->
<div class="glass-panel p-3 mb-4">
    <form method="get" id="filterForm" asp-action="SystemEvents">
        <input type="hidden" name="page" value="1" /> 
        
        <div class="row align-items-end">
            <!-- Rango Fechas -->
            <div class="col-md-3 mb-3">
                <label class="small text-muted font-weight-bold text-uppercase">Rango de Fechas</label>
                <div class="input-group input-daterange">
                    <input type="date" class="form-control bg-transparent text-white border-secondary" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")">
                    <div class="input-group-prepend input-group-append">
                        <span class="input-group-text bg-transparent border-secondary text-muted">to</span>
                    </div>
                    <input type="date" class="form-control bg-transparent text-white border-secondary" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")">
                </div>
            </div>
            
            <!-- Cargador -->
            <div class="col-md-2 mb-3">
                <label class="small text-muted font-weight-bold text-uppercase">Cargador</label>
                <select name="chargePointId" asp-items="Model.ChargePointList" class="form-control bg-transparent text-white border-secondary">
                </select>
            </div>
            
            <!-- Conector -->
            <div class="col-md-1 mb-3">
                <label class="small text-muted font-weight-bold text-uppercase">Con</label>
                <select name="connectorId" asp-items="Model.ConnectorList" class="form-control bg-transparent text-white border-secondary">
                </select>
            </div>
            
            <!-- Resultado -->
            <div class="col-md-2 mb-3">
                <label class="small text-muted font-weight-bold text-uppercase">Resultado</label>
                <select name="result" asp-items="Model.ResultList" class="form-control bg-transparent text-white border-secondary">
                </select>
            </div>
            
            <!-- Page Size -->
            <div class="col-md-2 mb-3">
                <label class="small text-muted font-weight-bold text-uppercase">Mostrar</label>
                <select name="pageSize" class="form-control bg-transparent text-white border-secondary" onchange="document.getElementById('filterForm').submit()">
                    <option value="25" selected="@(Model.PageSize == 25)">25 filas</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 filas</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100 filas</option>
                    <option value="500" selected="@(Model.PageSize == 500)">500 filas</option>
                </select>
            </div>

            <!-- Botones -->
            <div class="col-md-2 mb-3 d-flex">
                <button type="submit" class="btn btn-primary shadow-glow flex-grow-1 mr-2" title="Filtrar">
                    <i class="fas fa-filter"></i>
                </button>
                <a href="@Url.Action("ExportSystemEvents", new { startDate = Model.StartDate, endDate = Model.EndDate, chargePointId = Model.SelectedChargePointId, result = Model.SelectedResult, connectorId = Model.SelectedConnectorId })" class="btn btn-success shadow-glow flex-grow-1" title="Exportar Excel">
                    <i class="fas fa-file-excel"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Results Table -->
<div class="glass-panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table-premium table-hover mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Cargador</th>
                    <th>Conector</th>
                    <th>Mensaje</th>
                    <th>Resultado</th>
                    <th>Código de Error</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Events != null && Model.Events.Any())
                {
                    foreach (var item in Model.Events)
                    {
                        var statusClass = "";
                        var icon = "";
                        var badgeStyle = "";
                        
                        if (string.Equals(item.Result, "Success", StringComparison.OrdinalIgnoreCase) || string.Equals(item.Result, "OK", StringComparison.OrdinalIgnoreCase)) {
                            statusClass = "text-success";
                            icon = "fa-check-circle";
                            badgeStyle = "background: rgba(129, 199, 132, 0.1); color: #81c784; border: 1px solid rgba(129, 199, 132, 0.2);";
                        } else if (string.Equals(item.Result, "Fail", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrEmpty(item.ErrorCode)) {
                            statusClass = "text-danger";
                            icon = "fa-times-circle";
                            badgeStyle = "background: rgba(229, 115, 115, 0.1); color: #e57373; border: 1px solid rgba(229, 115, 115, 0.2);";
                        } else {
                            statusClass = "text-muted";
                            icon = "fa-info-circle";
                            badgeStyle = "background: rgba(255, 255, 255, 0.05); color: #e0e0e0; border: 1px solid rgba(255, 255, 255, 0.1);";
                        }

                        <tr onclick="showEventDetails('@item.LogTime.ToLocalTime().ToString("g")', '@item.ChargePointId', '@item.ConnectorId', '@(item.Message?.Replace("'", "\\'").Replace("\n", " ") ?? "")', '@item.Result', '@item.ErrorCode')" style="cursor: pointer;">
                            <td>
                                <div class="font-weight-bold">@item.LogTime.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">@item.LogTime.ToLocalTime().ToString("HH:mm:ss")</div>
                            </td>
                            <td><span class="font-weight-bold text-white">@item.ChargePointId</span></td>
                            <td>
                                @if(item.ConnectorId.HasValue) {
                                    <span class="badge badge-pill badge-secondary">@item.ConnectorId</span>
                                } else {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="font-weight-medium">@item.Message</span>
                            </td>
                            <td>
                                <span class="badge px-3 py-2 rounded-pill d-inline-flex align-items-center" style="@badgeStyle">
                                    <i class="fas @icon mr-2"></i> @item.Result
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ErrorCode))
                                {
                                    <span class="text-danger font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> @item.ErrorCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="fas fa-search fa-3x text-muted mb-3 opacity-50"></i>
                            <h4 class="h5 text-muted">No se encontraron eventos</h4>
                            <p class="small text-muted">Intenta ajustar los filtros de búsqueda</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
        <small class="text-muted">Mostrando @Model.Events.Count de @Model.TotalItems eventos (Página @Model.CurrentPage de @Model.TotalPages)</small>
        
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link bg-dark border-secondary text-white" href="@Url.Action("SystemEvents", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, startDate = Model.StartDate, endDate = Model.EndDate, chargePointId = Model.SelectedChargePointId, result = Model.SelectedResult, connectorId = Model.SelectedConnectorId })" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link bg-dark border-secondary text-white" href="@Url.Action("SystemEvents", new { page = i, pageSize = Model.PageSize, startDate = Model.StartDate, endDate = Model.EndDate, chargePointId = Model.SelectedChargePointId, result = Model.SelectedResult, connectorId = Model.SelectedConnectorId })">@i</a>
                            </li>
                        }
                        else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                        {
                             <li class="page-item disabled"><span class="page-link bg-dark border-secondary text-muted">...</span></li>
                        }
                    }

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link bg-dark border-secondary text-white" href="@Url.Action("SystemEvents", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, startDate = Model.StartDate, endDate = Model.EndDate, chargePointId = Model.SelectedChargePointId, result = Model.SelectedResult, connectorId = Model.SelectedConnectorId })" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="eventDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content glass" style="background: #1c1b1f; border: 1px solid var(--glass-border);">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Detalle del Evento</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-white">
                <div class="mb-3">
                    <small class="text-muted d-block font-weight-bold text-uppercase">Fecha y Hora</small>
                    <span id="modalDate" class="h6"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <small class="text-muted d-block font-weight-bold text-uppercase">Cargador</small>
                        <span id="modalCp" class="text-primary-md font-weight-bold"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted d-block font-weight-bold text-uppercase">Conector</small>
                        <span id="modalConnector"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block font-weight-bold text-uppercase">Resultado</small>
                    <span id="modalResult" class="badge p-2"></span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block font-weight-bold text-uppercase">Mensaje Completo</small>
                    <div class="p-3 rounded bg-dark border border-secondary" style="background: rgba(0,0,0,0.3) !important; max-height: 200px; overflow-y: auto;">
                        <code id="modalMessage" class="text-light" style="white-space: pre-wrap; word-break: break-word;"></code>
                    </div>
                </div>
                <div id="modalErrorCodeContainer" class="mb-3 d-none">
                     <small class="text-muted d-block font-weight-bold text-uppercase text-danger">Código de Error</small>
                     <span id="modalErrorCode" class="text-danger font-weight-bold"></span>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showEventDetails(date, cp, conn, msg, result, error) {
        document.getElementById('modalDate').innerText = date;
        document.getElementById('modalCp').innerText = cp;
        document.getElementById('modalConnector').innerText = conn || '-';
        document.getElementById('modalMessage').innerText = msg;
        document.getElementById('modalErrorCode').innerText = error || '';
        
        const resultEl = document.getElementById('modalResult');
        resultEl.innerText = result;
        
        // Style badge
        resultEl.className = 'badge p-2'; // reset
        if (result === 'Success' || result === 'OK' || result === 'Accepted') {
            resultEl.classList.add('badge-success');
            resultEl.style.backgroundColor = 'rgba(129, 199, 132, 0.2)';
            resultEl.style.color = '#81c784';
        } else if (result === 'Fail' || error) {
            resultEl.classList.add('badge-danger');
            resultEl.style.backgroundColor = 'rgba(229, 115, 115, 0.2)';
            resultEl.style.color = '#e57373';
        } else {
             resultEl.classList.add('badge-secondary');
        }

        const errContainer = document.getElementById('modalErrorCodeContainer');
        if (error) {
            errContainer.classList.remove('d-none');
        } else {
            errContainer.classList.add('d-none');
        }

        $('#eventDetailModal').modal('show');
    }
</script>
