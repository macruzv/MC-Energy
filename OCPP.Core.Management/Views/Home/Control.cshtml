@using OCPP.Core.Database
@{
    ChargePoint cp = ViewBag.ChargePoint;
    ConnectorStatus connector = ViewBag.Connector;
    Transaction activeTx = ViewBag.ActiveTransaction;
    Transaction pendingTx = ViewBag.PendingTransaction;
    ChargePointStatus onlineStatus = ViewBag.OnlineStatus;
    
    if (cp == null || connector == null)
    {
        // Safety redirect or simple error message inside the layout
        <div class="container py-5 text-center text-white">
            <h3 class="text-danger"><i class="fas fa-exclamation-triangle mr-2"></i>Error de Acceso</h3>
            <p>No se pudo cargar la información de la estación o el conector. Por favor intente de nuevo.</p>
            <a href="~/" class="btn btn-primary-md rounded-pill px-4 mt-3">Volver al Inicio</a>
        </div>
        return;
    }

    bool isOnline = onlineStatus != null;
    string currentStatus = "Desconectado";
    string ocppStatus = "";
    double chargeRate = 0;
    
    if (isOnline && onlineStatus.OnlineConnectors != null && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId))
    {
        var ocs = onlineStatus.OnlineConnectors[connector.ConnectorId];
        currentStatus = ocs.Status.ToString();
        ocppStatus = ocs.OcPPStatus ?? "";
        chargeRate = ocs.ChargeRateKW ?? 0;
    }
    
    // Logic Refinement: Recognize active charging even if status is simplified to "Occupied"
    bool isCharging = (currentStatus == "Charging" || ocppStatus == "Charging" || ocppStatus == "SuspendedEVSE" || ocppStatus == "SuspendedEV" || chargeRate > 0);
    // Block start if Pending present
    bool canStart = (activeTx == null && pendingTx == null && (currentStatus == "Preparing" || currentStatus == "Occupied" || currentStatus == "Available")); 

    string cid = Context.Request.Query["cid"];
    string cnm = Context.Request.Query["cnm"];
    string tel = Context.Request.Query["tel"];
    string eml = Context.Request.Query["eml"];
}

<div class="container-fluid">
    @if (!string.IsNullOrEmpty(cid))
    {
        <div class="row justify-content-center mb-4">
            <div class="col-md-5">
                <div class="glass p-3 px-4 d-flex align-items-center justify-content-between" style="border-radius: 20px;">
                    <div>
                        <small class="text-muted d-block text-uppercase font-weight-bold" style="letter-spacing: 1px;">Cliente Seleccionado</small>
                        <span class="font-weight-bold text-primary">@(string.IsNullOrEmpty(cnm) ? cid : cnm)</span>
                    </div>
                    <div class="text-right">
                        <small class="text-muted d-block">@tel</small>
                        <small class="text-muted">@eml</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Main Status Card -->
        <div class="col-md-5">
            <div class="card glass mb-4">
                <div class="card-body text-center py-5" style="position: relative; z-index: 1;">
                    <div class="card-circuit-overlay"></div>
                    <div class="status-indicator-lg @(isOnline ? "online" : "offline") mb-4" style="width: 160px; height: 160px;">
                        <img src="@Url.Content("~/img/Pistola.png")" style="width: 100%; height: auto; position: relative; z-index: 2; mix-blend-mode: screen; @(isOnline ? "filter: drop-shadow(0 0 20px rgba(0, 255, 128, 0.3));" : "filter: grayscale(1) opacity(0.5);")" />
                    </div>
                    <h2 class="mb-1 font-weight-bold" style="font-size: 2.8rem; text-transform: uppercase; letter-spacing: 2px;">CONECTOR #@connector.ConnectorId</h2>
                    <p class="text-muted" style="font-size: 1.2rem;">@(connector.ConnectorName ?? "Sin Nombre")</p>
                    
                    <div class="status-badge-premium mt-4">
                        <span id="status-text">@currentStatus</span>
                    </div>

                    <div id="control-actions" class="mt-5 d-flex flex-column align-items-center gap-3">
                        @if (activeTx == null)
                        {
                            // Logic Update: Only show pending recovery if charger is ONLINE and responsive
                            if (pendingTx != null && isOnline && currentStatus != "Unavailable" && currentStatus != "Unknown")
                            {
                                <!-- PENDING SESSION RECOVERY UI -->
                                <div class="w-100 p-4 mb-3 text-left" style="background: rgba(255, 193, 7, 0.1); border: 1px dashed rgba(255, 193, 7, 0.3); border-radius: 16px;">
                                    <h5 class="text-warning font-weight-bold mb-3"><i class="fas fa-exclamation-triangle mr-2"></i>SESIÓN PENDIENTE</h5>
                                    
                                    <div class="mb-2">
                                        <small class="text-muted d-block text-uppercase">Cliente</small>
                                        <span class="font-weight-bold text-white">@(ViewBag.PendingCustomerName ?? "Desconocido")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3">
                                        <div>
                                            <small class="text-muted d-block text-uppercase">Energía</small>
                                            <span class="font-weight-bold text-white">@((pendingTx.MeterStop - pendingTx.MeterStart)?.ToString("F2") ?? "0.00") kWh</span>
                                        </div>
                                        <div class="text-right">
                                            <small class="text-muted d-block text-uppercase">Fin</small>
                                            <span class="font-weight-bold text-white">@pendingTx.StopTime?.ToLocalTime().ToString("t")</span>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column mt-4">
                                        <button onclick="ClosePending(@pendingTx.TransactionId)" class="btn btn-warning btn-lg w-100 py-3 font-weight-bold text-dark shadow-glow mb-5" style="border-radius: 20px; font-size: 1.3rem;">
                                            <i class="fas fa-print mr-2"></i><i class="fas fa-check mr-2"></i> CERRAR Y IMPRIMIR
                                        </button>
                                        
                                        @if (currentStatus == "Available" || currentStatus == "Occupied" || currentStatus == "Preparing")
                                        {
                                            <button onclick="ContinueTransaction(@pendingTx.TransactionId, '@(pendingTx.StartTagId ?? "")')" class="btn btn-outline-success btn-lg w-100 py-3 font-weight-bold" style="border-radius: 20px; font-size: 1.3rem; border-width: 2px; box-shadow: 0 0 15px rgba(0, 255, 128, 0.2);">
                                                <i class="fas fa-play mr-2"></i> CONTINUAR SESIÓN
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted small mt-2">
                                                <i class="fas fa-exclamation-triangle mr-1"></i> No se puede continuar (Cargador @currentStatus)
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="small text-muted text-center w-75 mx-auto">
                                    <i class="fas fa-info-circle mr-1"></i> Debe cerrar la sesión anterior para iniciar una nueva.
                                </div>
                            }
                            else
                            {
                                <div class="w-100 mb-3 text-left @(!string.IsNullOrEmpty(cid) ? "d-none" : "")">
                                    <label class="small text-muted font-weight-bold mb-2"><i class="fas fa-id-card mr-1"></i> SELECCIONAR TARJETA (RFID)</label>
                                    <select id="selTag" class="form-control bg-transparent text-white border-subtle rounded-pill px-4" onchange="updateCustomerName(this)">
                                        <option value="21222122" class="bg-dark">Sin Tarjeta (Temporal)</option>
                                        @if (ViewBag.Tags != null)
                                        {
                                            foreach (var tag in ViewBag.Tags as List<OCPP.Core.Database.ChargeTag>)
                                            {
                                                <option value="@tag.TagId" data-customer="@(tag.Customer?.Name ?? "Sin Cliente")" class="bg-dark">
                                                    @tag.TagId (@(tag.TagName ?? "Sin Nombre"))
                                                </option>
                                            }
                                        }
                                    </select>
                                    <div id="selected-customer" class="mt-2 small text-primary-md font-weight-bold d-none">
                                        <i class="fas fa-user mr-1"></i> Cliente: <span id="cust-name"></span>
                                    </div>
                                </div>

                                <button id="btnStart" class="btn btn-primary btn-lg px-5 rounded-pill shadow-glow @(canStart ? "" : "disabled") w-100" 
                                        @(canStart ? "onclick=StartCharging()" : "disabled")>
                                    <i class="fas fa-play mr-2"></i> INICIAR CARGA
                                </button>
                                @if (!canStart)
                                {
                                    <div id="start-warning" class="mt-1 text-warning small text-center">
                                        @if (currentStatus == "Available")
                                        {
                                            <i class="fas fa-plug mr-1"></i> <text>Por favor, conecte el vehículo para iniciar</text>
                                        }
                                        else if (currentStatus == "Preparing" || currentStatus == "Occupied")
                                        {
                                            <i class="fas fa-check-circle mr-1"></i> <text>Vehículo detectado, listo para iniciar</text>
                                        }
                                        else
                                        {
                                            <i class="fas fa-exclamation-circle mr-1"></i> <text>Cargador fuera de línea o no disponible (@currentStatus)</text>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(activeTx.CustomerIdentifier))
                            {
                                <div class="badge badge-info-soft py-2 px-4 rounded-pill mb-3">
                                    <i class="fas fa-user-check mr-2"></i> SESIÓN: @(ViewBag.ActiveCustomerName ?? activeTx.CustomerIdentifier)
                                </div>
                            }

                            @if (isCharging || currentStatus == "Finishing" || true) // Allow stop always if activeTx exists
                            {
                                <button id="btnStop" class="btn btn-danger btn-lg px-5 rounded-pill shadow-glow-danger w-100" onclick="StopCharging('@activeTx.TransactionId', @connector.ConnectorId)">
                                    <i class="fas fa-stop mr-2"></i> PARAR CARGA
                                </button>
                                
                                @if (!isCharging && currentStatus != "Finishing")
                                {
                                    <div class="w-100 mt-2 text-center text-muted small">
                                        <i class="fas fa-spinner fa-spin mr-1"></i> Esperando inicio físico...
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metrics Side -->
        <div class="col-md-7">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card glass text-center py-4">
                        <small class="text-uppercase text-muted font-weight-bold">Potencia (kW)</small>
                        <h1 class="display-4 mt-2" id="val-kw">@(isOnline && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId) ? onlineStatus.OnlineConnectors[connector.ConnectorId].ChargeRateKW?.ToString("0.0") ?? "0.0" : "0.0")</h1>
                        <div class="progress mx-5 mt-2" style="height: 4px;">
                            <div class="progress-bar bg-info" style="width: 70%"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card glass text-center py-4">
                        <small class="text-uppercase text-muted font-weight-bold">Energía (kWh)</small>
                        <h1 class="display-4 mt-2" id="val-kwh">@(activeTx != null ? ((activeTx.MeterStop ?? activeTx.MeterStart) - activeTx.MeterStart).ToString("0.0") : "0.0")</h1>
                        <p class="mb-0 text-info">Resiliencia OK <i class="fas fa-shield-alt"></i></p>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="card glass p-4" id="timeline-container">
                        <h5 class="mb-4">Seguimiento de Sesión</h5>
                        
                        <div class="row align-items-center">
                            <!-- Left Column: Timeline -->
                            <div class="col-md-7" style="border-right: 1px solid rgba(255,255,255,0.05);">
                                <div style="height: 200px; border-left: 2px solid var(--md-sys-color-outline-variant); margin-left: 20px;">
                                    <div class="timeline-item">
                                        <div class="timeline-marker bg-success"></div>
                                        <div class="timeline-content">
                                            <h6 class="mb-0">Manguera Conectada</h6>
                                            <small class="text-muted">Listo para autorizar</small>
                                        </div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-marker @(activeTx != null ? "bg-info" : "bg-secondary")"></div>
                                        <div class="timeline-content">
                                            <h6 class="mb-0">Carga Iniciada</h6>
                                            <small class="text-muted">Registro activo en DB</small>
                                        </div>
                                    </div>
                                    <div class="timeline-item current pb-0">
                                        <div class="timeline-marker @(isOnline && currentStatus == "Charging" ? "bg-primary pulse" : "bg-secondary")"></div>
                                        <div class="timeline-content">
                                            <h6 class="mb-0">Transmitiendo Datos 
                                                @if (isOnline && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId) && onlineStatus.OnlineConnectors[connector.ConnectorId].SoC.HasValue)
                                                {
                                                    <span class="badge badge-soc p-1 px-2 ml-2" style="font-size: 0.7rem; background: rgba(0, 255, 128, 0.1); color: #00ff80; border: 1px solid rgba(0, 255, 128, 0.2); border-radius: 4px;">
                                                        <i class="fas fa-battery-three-quarters mr-1"></i> SoC <span id="val-soc-badge">@onlineStatus.OnlineConnectors[connector.ConnectorId].SoC.Value.ToString("0")</span>%
                                                    </span>
                                                }
                                            </h6>
                                            <small class="text-muted">Sincronización persistente activa</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Persistence Data (3 Lines) -->
                            <div class="col-md-5 pl-4" id="persistence-container">
                                @if (activeTx != null)
                                {
                                    <div class="d-flex flex-column gap-3">
                                        <div class="persistence-row">
                                            <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Inicio de Sesión</small>
                                            <div class="h5 mb-0 text-success font-weight-bold">
                                                <i class="fas fa-history mr-2 opacity-50"></i>
                                                @activeTx.StartTime.ToLocalTime().ToString("t")
                                            </div>
                                        </div>
                                        <div class="persistence-row py-2" style="border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);">
                                            <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Última Sincro</small>
                                            <div class="h5 mb-0 text-info font-weight-bold">
                                                <i class="fas fa-sync mr-2 opacity-50"></i>
                                                <span id="sync-time">@(connector.LastMeterTime?.ToLocalTime().ToString("t") ?? "N/A")</span>
                                            </div>
                                        </div>
                                        <div class="persistence-row">
                                            <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Lectura Acumulada</small>
                                            <div class="h4 mb-0 text-white font-weight-bold">
                                                <i class="fas fa-bolt mr-2 text-warning"></i>
                                                <span id="meter-val">@((activeTx.MeterStop ?? activeTx.MeterStart).ToString("N2"))</span>
                                                <small class="text-muted ml-1" style="font-size: 0.8rem;">kWh</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 opacity-50">
                                        <i class="fas fa-shield-alt fa-3x d-block mb-3"></i>
                                        <p class="small mb-0">No hay sesión activa para rastrear resiliencia.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Telemetry Grid Proposal -->
                        <div class="telemetry-grid mt-4 p-3" style="background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1); display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                            <div class="text-center">
                                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.6rem; letter-spacing: 1px;">Batería (BMS)</small>
                                <span class="h5 mb-0 text-primary-md font-weight-bold"><span id="val-temp-bms">@(isOnline && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId) ? onlineStatus.OnlineConnectors[connector.ConnectorId].BmsTemp?.ToString("0.0") ?? "--" : "--")</span><small class="text-muted ml-1">°C</small></span>
                            </div>
                            <div class="text-center" style="border-left: 1px solid rgba(255,255,255,0.1); border-right: 1px solid rgba(255,255,255,0.1);">
                                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.6rem; letter-spacing: 1px;">Estado Carga</small>
                                <span class="h5 mb-0 text-info font-weight-bold"><span id="val-soc-main">@(isOnline && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId) ? onlineStatus.OnlineConnectors[connector.ConnectorId].SoC?.ToString("0") ?? "--" : "--")</span><small class="text-muted ml-1">%</small></span>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block text-uppercase font-weight-bold" style="font-size: 0.6rem; letter-spacing: 1px;">Equipo</small>
                                <span class="h5 mb-0 text-primary-md font-weight-bold"><span id="val-temp-charger">@(isOnline && onlineStatus.OnlineConnectors.ContainsKey(connector.ConnectorId) ? onlineStatus.OnlineConnectors[connector.ConnectorId].ChargerTemp?.ToString("0.0") ?? "--" : "--")</span><small class="text-muted ml-1">°C</small></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let sessionStarting = false;

    function updateCustomerName(select) {
        const option = select.options[select.selectedIndex];
        const custName = option.getAttribute('data-customer');
        const container = document.getElementById('selected-customer');
        const nameSpan = document.getElementById('cust-name');
        
        if (custName && custName !== 'Sin Cliente') {
            nameSpan.innerText = custName;
            container.classList.remove('d-none');
        } else {
            container.classList.add('d-none');
        }
    }

    function StartCharging() {
        const cid = '@cid';
        const tel = '@tel';
        const eml = '@eml';
        const tag = document.getElementById('selTag')?.value || '21222122';
        
        Swal.fire({
            title: 'Iniciar Carga',
            text: `¿Deseas iniciar la carga con la tarjeta ${tag}?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, iniciar',
            background: '#1c1b1f',
            color: '#fff',
            confirmButtonColor: '#d0bcff',
            cancelButtonColor: '#49454f'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({ 
                    title: 'Enviando...', 
                    html: 'Comunicando con el cargador. Por favor, espere...',
                    background: '#1c1b1f',
                    color: '#fff',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading() 
                });
                
                let apiUrl = `@Url.Content("~/API/RemoteStart/")@(cp.ChargePointId)?cId=@(connector.ConnectorId)&tag=${encodeURIComponent(tag)}`;
                if (cid) apiUrl += `&customerId=${encodeURIComponent(cid)}&customerPhone=${encodeURIComponent(tel)}&customerEmail=${encodeURIComponent(eml)}`;

                fetch(apiUrl)
                    .then(r => {
                        if (!r.ok) {
                            const error = new Error(r.statusText || 'Error del servidor');
                            error.status = r.status;
                            throw error;
                        }
                        return r.text();
                    })
                    .then(msg => {
                        if (msg.includes('aceptado') || msg.includes('Accepted')) {
                            Swal.fire({
                                title: '¡Comando Aceptado!',
                                text: 'El cargador ha recibido la orden de inicio. La carga comenzará en breve.',
                                icon: 'success',
                                background: '#1c1b1f',
                                color: '#fff',
                                confirmButtonColor: '#d0bcff'
                            }).then(() => {
                                // Instead of immediate reload, we enter "Starting" state
                                sessionStarting = true;
                                const btn = document.getElementById('btnStart');
                                if (btn) {
                                    btn.classList.add('disabled');
                                    btn.disabled = true;
                                    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> INICIANDO...';
                                }
                            });
                        } else {
                            // Smart Error Parsing
                            let errorTitle = 'No se pudo iniciar';
                            let errorText = msg;
                            let errorIcon = 'error';

                            if (msg.startsWith('Error:')) {
                                errorText = msg.substring(6).trim(); // Remove 'Error:' prefix
                                errorTitle = 'Atención';
                                errorIcon = 'warning';
                            } else if (msg.trim().startsWith('<')) {
                                errorTitle = 'Error del Servidor';
                                errorText = 'Ocurrió un error interno en el servidor. Por favor contacte a soporte.';
                            } else if (msg.includes('rechazó')) {
                                errorTitle = 'Cargador Ocupado o No Disponible';
                                errorIcon = 'warning';
                            }

                            Swal.fire({ 
                                title: errorTitle, 
                                html: `<div class="text-left">${errorText}</div>`, 
                                icon: errorIcon,
                                background: '#1c1b1f',
                                color: '#fff',
                                confirmButtonColor: '#cf6679'
                            });
                        }
                    })
                    .catch(err => {
                        console.error("StartCharging Error:", err);
                        Swal.fire({ 
                            title: 'Error de Comunicación', 
                            html: `<div class="text-left font-weight-bold">No se pudo conectar con el servidor.</div>
                                   <div class="text-left small text-muted mt-2">Detalle: ${err.message}</div>
                                   <div class="text-left small text-muted mt-1">Status: ${err.status || 'N/A'}</div>`, 
                            icon: 'error',
                            background: '#1c1b1f',
                            color: '#fff'
                        });
                    });
            }
        });
    }

    function StopCharging(tId, cId) {
        Swal.fire({
            title: 'Detener Carga',
            text: "¿Estás seguro de detener la sesión?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f44336',
            cancelButtonColor: '#49454f',
            confirmButtonText: 'Sí, parar',
            background: '#1c1b1f',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({ 
                    title: 'Parando...', 
                    text: 'Enviando comando de parada y cerrando sesión...',
                    background: '#1c1b1f',
                    color: '#fff',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading() 
                });
                
                // 1. Send Remote Stop
                fetch(`@Url.Content("~/API/RemoteStop/")@cp.ChargePointId?tId=${tId}&cId=${cId}`)
                    .then(r => r.text())
                    .then(msg => {
                        // 2. Wait 2 seconds for charger to update DB (StopTransaction) so Ticket is correct
                        return new Promise(resolve => setTimeout(resolve, 2000));
                    })
                    .then(() => {
                        // 3. Open Ticket
                        window.open(`@Url.Content("~/Home/Ticket/")` + tId + '?print=true', '_blank');
                        
                        // 4. Auto-Acknowledge since user manually stopped it
                        return fetch(`@Url.Content("~/Home/AcknowledgeTransaction")?tId=${tId}`, { method: 'POST' });
                    })
                    .then(() => {
                        // 5. Reload to fresh state (bypassing Pending screen)
                        location.reload();
                    })
                    .catch(e => {
                        console.error(e);
                        location.reload();
                    });
            }
        });
    }

    function ClosePending(tId) {
        Swal.fire({
            title: 'Cerrar Sesión',
            text: "¿Confirmas cerrar esta sesión e imprimir el ticket final?",
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Sí, cerrar',
            cancelButtonText: 'Cancelar',
            background: '#1c1b1f',
            color: '#fff',
            confirmButtonColor: '#ffc107',
        }).then((result) => {
            if (result.isConfirmed) {
                 // 1. Open Ticket Window
                 window.open(`@Url.Content("~/Home/Ticket/")` + tId + '?print=true', '_blank');

                 // 2. Acknowledge and Reload
                 fetch(`@Url.Content("~/Home/AcknowledgeTransaction")?tId=${tId}`, { method: 'POST' })
                    .then(r => {
                        if (r.ok) {
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            Swal.fire('Error', 'No se pudo cerrar la sesión', 'error');
                        }
                    });
            }
        });
    }

    function ContinueTransaction(tId, tagId) {
        if (!tagId || tagId === "") tagId = "21222122"; // Pass default or error if tag missing
        Swal.fire({
            title: 'Continuar Sesión',
            text: "¿Deseas cerrar la sesión anterior y continuar inmediatamente iniciando una nueva?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, continuar',
            cancelButtonText: 'Cancelar',
            background: '#1c1b1f',
            color: '#fff',
            confirmButtonColor: '#00c853'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Procesando...',
                    html: 'Cerrando sesión anterior e iniciando nueva...',
                    background: '#1c1b1f',
                    color: '#fff',
                    didOpen: () => { Swal.showLoading() }
                });

                // 1. Acknowledge old transaction
                fetch(`@Url.Content("~/Home/AcknowledgeTransaction")?tId=${tId}`, { method: 'POST' })
                    .then(r => {
                        if (r.ok) {
                            // 2. Start new transaction
                            // Reuse existing quickstart params if available
                            const cid = '@cid';
                            const tel = '@tel';
                            const eml = '@eml';

                            let apiUrl = `@Url.Content("~/API/RemoteStart/")@(cp.ChargePointId)?cId=@(connector.ConnectorId)&tag=${encodeURIComponent(tagId)}`;
                            if (cid) apiUrl += `&customerId=${encodeURIComponent(cid)}&customerPhone=${encodeURIComponent(tel)}&customerEmail=${encodeURIComponent(eml)}`;

                            return fetch(apiUrl);
                        } else {
                            throw new Error("Failed to close previous session");
                        }
                    })
                    .then(r => {
                        if (!r.ok) throw new Error("Start command failed: " + r.statusText);
                        return r.text();
                    })
                    .then(msg => {
                        if (msg.includes('aceptado') || msg.includes('Accepted')) {
                            Swal.fire({
                                title: '¡Sesión Iniciada!',
                                text: 'Se ha continuado la carga exitosamente.',
                                icon: 'success',
                                background: '#1c1b1f',
                                color: '#fff'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                             Swal.fire({
                                title: 'No se pudo iniciar',
                                text: msg,
                                icon: 'warning',
                                background: '#1c1b1f',
                                color: '#fff'
                            }).then(() => location.reload()); // Reload anyway as old session is closed
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire('Error', 'Hubo un problema al continuar la sesión: ' + err.message, 'error').then(() => location.reload());
                    });
            }
        });
    }

    // Real-time status polling for better responsiveness
    setInterval(() => {
        if (!Swal.isVisible()) {
            // Cache busting with timestamp
            fetch(window.location.href + (window.location.href.includes('?') ? '&' : '?') + 't=' + new Date().getTime())
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    // If we were waiting for a session to start, check if the "Stop" button is now present
                    if (sessionStarting) {
                        const newBtnStop = doc.getElementById('btnStop');
                        if (newBtnStop) {
                            console.log("Session detected! Clearing starting state.");
                            sessionStarting = false;
                        }
                    }

                    // Update only specific parts to avoid flicker
                    const newStatus = doc.getElementById('status-text').innerHTML;
                    const newBtnContainer = doc.getElementById('control-actions');
                    const newPersistence = doc.getElementById('persistence-container');
                    const newTimeline = doc.getElementById('timeline-container');
                    const newStatusIndicator = doc.querySelector('.status-indicator-lg');
                    
                    if (document.getElementById('status-text').innerHTML !== newStatus) {
                        document.getElementById('status-text').innerHTML = newStatus;
                    }
                    
                    const currentBtnContainer = document.getElementById('control-actions');
                    if (currentBtnContainer && newBtnContainer) {
                        // If we are in "Starting" state, we block reverting the button container 
                        // UNLESS the new container has a Stop button (meaning session is confirmed)
                        const hasStopBtn = newBtnContainer.querySelector('#btnStop');
                        
                        if (!sessionStarting || hasStopBtn) {
                            if (currentBtnContainer.innerHTML.trim() !== newBtnContainer.innerHTML.trim()) {
                                currentBtnContainer.innerHTML = newBtnContainer.innerHTML;
                            }
                        }
                    }

                    const currentPersistence = document.getElementById('persistence-container');
                    if (currentPersistence && newPersistence && currentPersistence.innerHTML.trim() !== newPersistence.innerHTML.trim()) {
                        currentPersistence.innerHTML = newPersistence.innerHTML;
                    }

                    const currentTimeline = document.getElementById('timeline-container');
                    if (currentTimeline && newTimeline && currentTimeline.innerHTML.trim() !== newTimeline.innerHTML.trim()) {
                        currentTimeline.innerHTML = newTimeline.innerHTML;
                    }

                    if (newStatusIndicator) {
                        const currentIndicator = document.querySelector('.status-indicator-lg');
                        if (currentIndicator && currentIndicator.className !== newStatusIndicator.className) {
                            currentIndicator.className = newStatusIndicator.className;
                            const img = currentIndicator.querySelector('img');
                            const newImg = newStatusIndicator.querySelector('img');
                            if (img && newImg) img.style.filter = newImg.style.filter;
                        }
                    }

                    // Update metrics
                    ['val-kw', 'val-kwh', 'sync-time', 'meter-val', 'val-soc-badge', 'val-soc-main', 'val-temp-bms', 'val-temp-charger'].forEach(id => {
                        const oldEl = document.getElementById(id);
                        const newEl = doc.getElementById(id);
                        if (oldEl && newEl && oldEl.innerHTML.trim() !== newEl.innerHTML.trim()) {
                            oldEl.innerHTML = newEl.innerHTML;
                        }
                    });
                })
                .catch(err => console.warn("Poll error:", err));
        }
    }, 3000);
</script>

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --glass-blur: blur(20px);
        --accent-glow: rgba(208, 188, 255, 0.4);
    }

    .glass {
        background: var(--glass-bg) !important;
        backdrop-filter: var(--glass-blur) !important;
        -webkit-backdrop-filter: var(--glass-blur) !important;
        border: 1px solid var(--glass-border) !important;
        border-radius: 32px !important;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3) !important;
        color: #fff !important;
    }

    .card { border: none; }
    .card-header { border-bottom: 1px solid var(--glass-border); }
    .list-group-item { background: transparent !important; color: #fff !important; border-color: var(--glass-border) !important; }

    .status-indicator-lg { 
        width: 120px; height: 120px; border-radius: 50%; 
        display: inline-flex; align-items: center; justify-content: center; 
        margin-bottom: 24px;
        background: rgba(255,255,255,0.05);
        position: relative;
    }
    
    .status-indicator-lg.online::after {
        content: ''; position: absolute; width: 130%; height: 130%;
        border-radius: 50%; border: 2px solid rgba(0, 255, 128, 0.2);
        animation: pulse-ring 2s infinite;
    }

    @@keyframes pulse-ring {
        0% { transform: scale(0.8); opacity: 0.5; }
        100% { transform: scale(1.3); opacity: 0; }
    }

    .status-indicator-lg.online { color: #00ff80; }
    .status-indicator-lg.offline { color: #ff4040; }
    
    .status-badge-premium { 
        background: rgba(208, 188, 255, 0.1); 
        border: 1px solid rgba(208, 188, 255, 0.2); 
        padding: 14px 40px; border-radius: 100px; 
        display: inline-block; font-weight: 700; font-size: 1.2rem; 
        letter-spacing: 2px; color: #d0bcff;
        text-transform: uppercase;
        box-shadow: 0 0 20px rgba(208, 188, 255, 0.1);
    }
    
    .shadow-glow { 
        background: linear-gradient(135deg, #d0bcff 0%, #a88dff 100%) !important;
        border: none !important;
        box-shadow: 0 0 30px rgba(208, 188, 255, 0.4) !important;
        color: #381e72 !important; font-weight: 800 !important;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .shadow-glow:hover { transform: scale(1.05); box-shadow: 0 0 40px rgba(208, 188, 255, 0.6) !important; }
    
    .shadow-glow.disabled, .shadow-glow:disabled {
        background: rgba(255,255,255,0.05) !important;
        box-shadow: none !important;
        color: rgba(255,255,255,0.2) !important;
        cursor: not-allowed;
        transform: none !important;
    }

    .shadow-glow-danger { 
        background: linear-gradient(135deg, #ff5252 0%, #d32f2f 100%) !important;
        border: none !important;
        box-shadow: 0 0 30px rgba(255, 82, 82, 0.4) !important;
        color: #fff !important; font-weight: 800 !important;
    }

    .timeline-item { position: relative; padding-left: 50px; padding-bottom: 40px; }
    .timeline-marker { 
        position: absolute; left: -11px; top: 0; 
        width: 22px; height: 22px; border-radius: 50%; 
        border: 4px solid #1c1b1f; 
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }
    
    .display-4 { font-weight: 800; letter-spacing: -2px; }
    .text-info { color: #81d4fa !important; }
    .text-primary-md { color: var(--primary-md) !important; }
    .badge-info-soft {
        background: rgba(208, 188, 255, 0.1);
        color: #d0bcff;
        border: 1px solid rgba(208, 188, 255, 0.2);
    }
</style>
}
