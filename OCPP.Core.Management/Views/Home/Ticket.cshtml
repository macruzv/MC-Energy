@model OCPP.Core.Database.Transaction
@using OCPP.Core.Database
@{
    Layout = null;
    double energyKWh = 0;
    if (Model.MeterStop.HasValue) 
    {
        energyKWh = (Model.MeterStop.Value - Model.MeterStart);
    }
    else if (Model.TransactionId == 0) // Demo data
    {
        energyKWh = 12.5;
    }
    
    string billingMode = ViewBag.BillingMode ?? "Energy";
    string pricingType = ViewBag.PricingType ?? "Fixed";
    string pricingSchedulesJson = ViewBag.PricingSchedules ?? "[]";
    
    decimal currentPrice = decimal.Parse(ViewBag.PricePerKWh ?? "0.00");
    
    if (pricingType == "Scheduled")
    {
        try 
        {
            var schedules = Newtonsoft.Json.JsonConvert.DeserializeObject<List<dynamic>>(pricingSchedulesJson);
            var startTime = Model.StartTime.TimeOfDay;
            
            foreach (var s in schedules)
            {
                TimeSpan start = TimeSpan.Parse((string)s.start);
                TimeSpan end = TimeSpan.Parse((string)s.end);
                decimal price = (decimal)s.price;
                
                if (start <= end)
                {
                    if (startTime >= start && startTime <= end)
                    {
                        currentPrice = price;
                        break;
                    }
                }
                else // Overlaps midnight (e.g. 22:00 to 06:00)
                {
                    if (startTime >= start || startTime <= end)
                    {
                        currentPrice = price;
                        break;
                    }
                }
            }
        }
        catch {}
    }

    decimal usageFee = decimal.Parse(ViewBag.UsageFee ?? "0.00"); // Usage Fee

    decimal total = 0;
    double durationMinutes = 0; // Updated: Minutes
    
    if (billingMode == "Time")
    {
        if (Model.StopTime.HasValue)
        {
            durationMinutes = (Model.StopTime.Value - Model.StartTime).TotalMinutes;
        }
        else if (Model.TransactionId == 0) // Demo
        {
            durationMinutes = 90; // 1.5 hours = 90 mins
        }
        // Cost = (Minutes * Price) + UsageFee
        total = ((decimal)durationMinutes * currentPrice) + usageFee;
    }
    else // Energy
    {
        total = (decimal)energyKWh * currentPrice;
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprobante #@Model.TransactionId</title>
    @{
        string printerWidth = ViewBag.PrinterWidth ?? "56";
        string printerDPI = ViewBag.PrinterDPI ?? "150";
        string fontSize = "10pt";
        if (printerDPI == "72") fontSize = "9pt";
        else if (printerDPI == "300") fontSize = "11pt";

        // Buffer de seguridad para el ancho en Android Spooler
        // Algunos navegadores móviles fallan si el ancho de la página coincide exactamente con el del papel
    }
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            background: #fff;
            color: #000;
            font-family: 'Courier New', Courier, monospace;
            width: 100%;
            font-size: @(fontSize);
            line-height: 1.1;
        }

        .receipt {
            margin: 0 auto; /* CENTRADO DINÁMICO */
            padding: 2mm;
            width: @(printerWidth)mm;
            max-width: 100vw;
            overflow-x: hidden;
        }

        .line {
            white-space: pre-wrap; /* Cambiado a pre-wrap para evitar desbordes */
            word-break: break-all;
            display: block;
            width: 100%;
            margin: 0;
        }

        .center { text-align: center; }
        .bold { font-weight: bold; }
        .separator { border-top: 1px dashed #000; margin: 2mm 0; }
        .double-separator { border-top: 1px double #000; margin: 2mm 0; }

        @@media print {
            .no-print { display: none; }
            body { 
                width: 100%; 
                padding: 0;
                margin: 0;
            }
            .receipt {
                margin: 0 auto;
                width: @(printerWidth)mm;
                padding: 1mm;
            }
            @@page {
                margin: 0;
                size: auto;
            }
        }
    </style>
</head>
<body onload="if(window.location.search.includes('print')) { setTimeout(() => { window.print(); }, 1000); }" onafterprint="setTimeout(() => { window.close(); }, 500);">

    <div class="receipt">
        <div class="center bold">
            <span style="font-size: 12pt;">@ViewBag.CompanyName</span><br>
            <span style="font-size: 8pt;">@ViewBag.CompanyAddress</span><br>
            @if (!string.IsNullOrEmpty(ViewBag.CompanyBranch))
            {
                <span style="font-size: 8pt;">Sucursal: @ViewBag.CompanyBranch</span>
            }
        </div>
        
        <div class="separator"></div>
        <div class="center bold">COMPROBANTE DE CARGA</div>
        <div class="separator"></div>

        <div class="line">TRX: #@(Model.TransactionId == 0 ? "DEMO-001" : Model.TransactionId.ToString())</div>
        <div class="line">FECHA: @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</div>
        <div class="line">CARG.: @Model.ChargePointId</div>
        <div class="line">CONEC: Boca #@Model.ConnectorId</div>

        @if (!string.IsNullOrEmpty(ViewBag.CustomerName) || !string.IsNullOrEmpty(Model.CustomerIdentifier))
        {
            <div class="separator"></div>
            <div class="line">@(ViewBag.CustomerName ?? Model.CustomerIdentifier)</div>
            @if (!string.IsNullOrEmpty(Model.CustomerPhone))
            {
                <div class="line">TEL: @Model.CustomerPhone</div>
            }
        }
        
        <div class="separator"></div>
        
        <div class="line">INICIAL: @Model.MeterStart.ToString("N2") kWh</div>
        <div class="line">FINAL:   @(Model.MeterStop?.ToString("N2") ?? "-") kWh</div>
        <div class="separator"></div>
        
        @if (billingMode == "Time")
        {
            <div class="line">INICIO: @Model.StartTime.ToString("hh:mm tt")</div>
            <div class="line">FIN:    @(Model.StopTime?.ToString("hh:mm tt") ?? "-")</div>
            <div class="line bold" style="font-size: 11pt;">DURACIÓN: @(durationMinutes.ToString("N0")) min.</div>
            <div class="line">PRECIO: $@currentPrice.ToString("N2")</div>
            @if(usageFee > 0)
            {
                <div class="line">USO DE ESPACIO: $@usageFee.ToString("N2")</div>
            }
        }
        else
        {
            <div class="line bold" style="font-size: 11pt;">CONSUMO: @energyKWh.ToString("N2") kWh</div>
            <div class="line">PRECIO/kWh: $@currentPrice.ToString("N2")</div>
        }
        
        @if (!string.IsNullOrEmpty(ViewBag.CollectorName) || !string.IsNullOrEmpty(ViewBag.OperatorName))
        {
            <div class="separator"></div>
            <div class="line">Atendido Por</div>
            <div class="line">@(ViewBag.CollectorName ?? ViewBag.OperatorName)</div>
        }
        
        <div class="separator"></div>
        <div class="center bold" style="font-size: 14pt; border: 1px solid #000; padding: 1mm;">
            TOTAL: $@total.ToString("N2")
        </div>
        <div class="separator"></div>

        <div class="center" style="font-size: 8pt;">
            *** GRACIAS POR CARGAR ***<br>
            Ahorraste @((energyKWh * 0.4).ToString("N2"))kg CO2<br>
            ¡Vuelva pronto!
        </div>

        <div class="center" style="font-size: 7pt; margin-top: 5mm;">
            No es una factura legal.
        </div>
    </div>

    <div class="no-print" style="position: fixed; bottom: 10px; left: 10px; right: 10px; text-align: center;">
        <button onclick="window.print()" style="padding: 12px 24px; background: #000; color: #fff; border: none; border-radius: 50px; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
            <i class="fas fa-print"></i> RE-IMPRIMIR
        </button>
    </div>

    </div>
</body>
</html>
