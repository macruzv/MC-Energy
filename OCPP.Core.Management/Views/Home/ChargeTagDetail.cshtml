﻿@using Microsoft.AspNetCore.Mvc.Localization
@model ChargeTagViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = @Localizer["Title"];
}
<br />

@if (Model != null)
{
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <a href="javascript:history.back()" class="text-muted small"><i class="fas fa-arrow-left"></i> @Localizer["Back"]</a>
        </div>

        <div class="glass-panel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 mb-0 font-weight-bold">
                    <i class="fas fa-tag text-primary-md mr-2"></i> @Localizer["EditChargeTag"]
                </h2>
                <button type="submit" class="btn btn-primary-md">
                    <i class="fas fa-save"></i> @Localizer[(Model.CurrentTagId == "@") ? "SaveNew" : "Save"]
                </button>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-4">
                        <label class="form-label-md" for="TagId">@Localizer["ChargeTagIdLabel"]</label>
                        @if (Model.CurrentTagId == "@")
                        {
                            <div class="d-flex align-items-center gap-2">
                                <input type="text" class="form-control-md w-100" data-val="true" data-val-length="@string.Format(Localizer["FieldMaxLength"].Value, 50)" data-val-length-max="50" data-val-required="@Localizer["RequiredField"]" id="TagId" maxlength="50" name="TagId" placeholder="@Localizer["ChargeTagIdPlaceholder"]" value="@Model.TagId">
                                <button type="button" onclick="startTagScan()" id="btnScanTag" class="btn btn-outline-info ml-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 38px; border-radius: 12px; border-color: rgba(0,255,128,0.5); color: #00ff80;" title="Escanear NFC">
                                    <i class="fas fa-wifi"></i>
                                </button>
                            </div>
                            <span class="field-validation-valid text-danger small mt-1" data-valmsg-for="TagId" data-valmsg-replace="true"></span>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <input type="text" readonly class="form-control-md w-100 text-muted" id="TagId" name="TagId" value="@Model.TagId">
                                <button type="button" onclick="startTagScan()" id="btnScanTagRef" class="btn btn-outline-secondary ml-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 38px; border-radius: 12px;" title="Actualizar por NFC">
                                    <i class="fas fa-wifi"></i>
                                </button>
                            </div>
                            <small class="text-muted">Escanee una nueva tarjeta para reemplazar este ID.</small>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label-md" for="TagName">@Localizer["ChargeTagNameLabel"]</label>
                        <input class="form-control-md w-100" data-val="true" data-val-length="@string.Format(Localizer["FieldMaxLength"].Value, 200)" data-val-length-max="200" data-val-required="@Localizer["RequiredField"]" id="TagName" maxlength="200" name="TagName" placeholder="@Localizer["ChargeTagNamePlaceholder"]" type="text" value="@Model.TagName" />
                        <span class="field-validation-valid text-danger small mt-1" data-valmsg-for="TagName" data-valmsg-replace="true"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label-md" for="VehicleId">Ficha / Vehículo</label>
                        <input class="form-control-md w-100" id="VehicleId" maxlength="50" name="VehicleId" placeholder="Ej. Ficha 123" type="text" value="@Model.VehicleId" />
                        <span class="field-validation-valid text-danger small mt-1" data-valmsg-for="VehicleId" data-valmsg-replace="true"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-md" for="ParentTagId">@Localizer["GroupNameLabel"]</label>
                        <div class="d-flex">
                            <select class="form-control-md w-100" id="ParentTagId" name="ParentTagId">
                                <option value="">-- @Localizer["GroupNamePlaceholder"] --</option>
                                @if (ViewBag.TagGroups != null)
                                {
                                    foreach (var group in (List<OCPP.Core.Database.TagGroup>)ViewBag.TagGroups)
                                    {
                                        if (Model.ParentTagId == group.Name)
                                        {
                                            <option value="@group.Name" selected>@group.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@group.Name">@group.Name</option>
                                        }
                                    }
                                }
                            </select>
                            <a asp-controller="TagGroups" asp-action="Index" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-outline-info ml-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 38px; border-radius: 12px;" title="Gestionar Grupos">
                                <i class="fas fa-cog"></i>
                            </a>
                        </div>
                        <span class="field-validation-valid text-danger small mt-1" data-valmsg-for="ParentTagId" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="col-md-6 border-left border-secondary" style="border-left: 1px solid var(--glass-border) !important;">
                    <div class="mb-4">
                        <label class="form-label-md" for="ExpiryDate">@Localizer["ChargeTagExpirationLabel"]</label>
                        <div class="input-group date" id="expiryDatetimepicker">
                            <input type="text" class="form-control-md w-100" id="ExpiryDate" name="ExpiryDate" value="@Model.ExpiryDate?.ToString("dd/MM/yyyy")" placeholder="dd/MM/yyyy" autocomplete="off" style="border-top-right-radius: 0; border-bottom-right-radius: 0;">
                            <div class="input-group-append">
                                <span class="input-group-text bg-dark border-secondary text-white" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px; border: 1px solid rgba(255,255,255,0.1); border-left: none;">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4 pt-2">
                        <div class="custom-control custom-switch">
                            @Html.CheckBoxFor(m => m.Blocked, new { @class = "custom-control-input", @id = "BlockedSwitch" })
                            <label class="custom-control-label font-weight-bold text-white" for="BlockedSwitch">@Localizer["ChargeTagBlockedLabel"]</label>
                        </div>
                        <small class="text-muted d-block mt-1 pl-1">Si se activa, esta etiqueta no podrá iniciar cargas.</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-md" for="Balance">Saldo</label>
                        <div class="input-group">
                            <input class="form-control-md w-100" data-val="true" data-val-number="The field Balance must be a number." data-val-required="The Balance field is required." id="Balance" name="Balance" type="text" value="@Model.Balance" />
                        </div>
                    </div>

                    <div class="mb-4 pt-2">
                        <div class="custom-control custom-switch">
                            @Html.CheckBoxFor(m => m.InfiniteBalance, new { @class = "custom-control-input", @id = "InfiniteBalanceSwitch" })
                            <label class="custom-control-label font-weight-bold text-white" for="InfiniteBalanceSwitch">Monto Infinito (Sin Límite)</label>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMsg))
            {
                <div class="alert alert-danger mt-3">
                    @ViewBag.ErrorMsg
                </div>
            }

            <div class="mt-4 border-top pt-4 d-flex" style="border-top: 1px solid var(--glass-border) !important;">
                @if (Model.CurrentTagId != "@")
                {
                    <button type="button" class="btn btn-outline-danger btn-md mr-auto" id="btnDelete" onclick="DeleteTag()">
                        <i class="fas fa-trash"></i> @Localizer["Delete"]
                    </button>
                }
                
                <button type="button" class="btn btn-outline-secondary btn-md ml-auto" id="btnBack" onclick="history.back()">
                    @Localizer["Back"]
                </button>
            </div>
        </div>
        <input type="hidden" name="action" id="hidAction" value="" />
    }

    @section scripts {
        <script>
            $(function () {
                $('#expiryDatetimepicker').datepicker({
                    format: 'dd/mm/yyyy',
                    weekStart: 1,
                    todayBtn: true,
                    language: "@ViewBag.Language",
                    todayHighlight: true,
                    autoclose: true,
                    orientation: "bottom auto"
                });
            });

            async function startTagScan() {
                if (!('NDEFReader' in window)) {
                    Swal.fire({ icon: 'error', title: 'NFC no soportado', text: 'Usa Chrome en Android.' });
                    return;
                }
                
                // Determine active button
                const btn = document.getElementById('btnScanTag') || document.getElementById('btnScanTagRef');
                
                try {
                    const ndef = new NDEFReader();
                    await ndef.scan();
                    
                    btn.classList.add('pulse-green');
                    
                    Swal.fire({
                        title: 'Listo para Escanear',
                        text: 'Acerca la tarjeta al dispositivo...',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 10000,
                        timerProgressBar: true,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    ndef.addEventListener("reading", ({ serialNumber }) => {
                        const tagId = serialNumber.replace(/:/g, "").toUpperCase();
                        
                        // Set value
                        const input = document.getElementById('TagId');
                        input.value = tagId;
                        input.readOnly = false; // Unlock if it was readonly
                        input.classList.remove('text-muted');
                        input.classList.add('text-white');
                        
                        // Visual feedback
                        btn.classList.remove('pulse-green');
                         Swal.fire({
                            icon: 'success',
                            title: 'Capturado',
                            text: `ID: ${tagId}`,
                            timer: 1500,
                            showConfirmButton: false
                        });
                    });
                } catch (error) {
                    console.error(error);
                    Swal.fire({ icon: 'error', title: 'Error NFC', text: error.message });
                }
            }

        function DeleteTag() {
                var dialog = new BootstrapDialog({
                    title: '@Localizer["TitleDelete"]',
                    message: '@Localizer["DialogDelete"]',
                    //spinicon: 'fa fa-spinner fa-fw',
                    buttons: [{
                        id: 'btnDialogReset',
                        label: '@Localizer["TitleDelete"]',
                        icon: 'fas fa-trash',
                        //autospin: true,
                        action: function (dialogRef) {
                            $("#hidAction").val('Delete');
                            $("form").submit();
                        }
                    }, {
                        id: 'btnDialogCancel',
                        label: '@Localizer["Cancel"]',
                        action: function (dialogRef) {
                            dialogRef.close();
                        }
                    }]
                });
                dialog.open();
            }
        </script>
        <style>
            .pulse-green {
                animation: pulse-green 1.5s infinite;
                background-color: rgba(0, 255, 128, 0.1);
                box-shadow: 0 0 0 0 rgba(0, 255, 128, 0.7);
            }
            
            @@keyframes pulse-green {
                0% { box-shadow: 0 0 0 0 rgba(0, 255, 128, 0.7); }
                70% { box-shadow: 0 0 0 10px rgba(0, 255, 128, 0); }
                100% { box-shadow: 0 0 0 0 rgba(0, 255, 128, 0); }
            }
        </style>
    }
}