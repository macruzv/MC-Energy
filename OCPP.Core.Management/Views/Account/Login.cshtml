@model OCPP.Core.Management.Models.UserModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ENERGY CORE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #007bff;
            --primary-dark: #0056b3;
            --bg-dark: #0f172a;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', sans-serif;
            background: #0f172a;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            color: white;
        }

        .login-wrapper {
            display: flex;
            width: 100%;
            height: 100%;
            max-width: 1200px;
            max-height: 800px;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.7);
        }

        .login-side-image {
            flex: 1.2;
            background: url('/img/login_bg.png') center center no-repeat;
            background-size: cover;
            position: relative;
            display: none;
        }

        @@media (min-width: 992px) {
            .login-side-image { display: block; }
        }

        .login-side-image::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to right, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.8) 100%);
        }

        .login-content {
            flex: 1;
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #0f172a;
        }

        .logo-section {
            margin-bottom: 40px;
        }

        .logo-section i {
            font-size: 3.5rem;
            color: var(--primary);
            margin-bottom: 15px;
            filter: drop-shadow(0 0 20px rgba(0, 123, 255, 0.4));
        }

        .logo-section h1 {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -1px;
            background: linear-gradient(to right, #fff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-section p {
            color: #94a3b8;
            font-size: 1rem;
            margin-top: 5px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #475569;
            transition: all 0.3s;
        }

        .form-control {
            width: 100%;
            padding: 16px 15px 16px 52px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            color: white;
            font-size: 1rem;
            box-sizing: border-box;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.05);
            box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.1);
        }

        .form-control:focus + i {
            color: var(--primary);
        }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary), #4f46e5);
            border: none;
            border-radius: 16px;
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 123, 255, 0.4);
            filter: brightness(1.1);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .error-message {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #f87171;
            padding: 14px;
            border-radius: 16px;
            font-size: 0.9rem;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
        }

        .login-wrapper {
            animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-side-image"></div>
        <div class="login-content">
            <div class="logo-section">
                <i class="fas fa-charging-station"></i>
                <h1>ENERGY CORE MC</h1>
                <p>Bienvenido. Inicie sesión para continuar.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @if (!Html.ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        <i class="fas fa-shield-alt"></i> Credenciales de acceso incorrectas
                    </div>
                }

                <div class="form-group">
                    <label>Nombre de Usuario</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user-circle"></i>
                        <input name="Username" class="form-control" placeholder="Nombre de usuario" required autofocus />
                    </div>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <div class="input-wrapper">
                        <i class="fas fa-fingerprint"></i>
                        <input name="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    INGRESAR <i class="fas fa-chevron-right"></i>
                </button>
            </form>

            <div style="margin-top: auto; color: #475569; font-size: 0.8rem; text-align: center;">
                &copy; @DateTime.Now.Year OCPP Core Management. Todos los derechos reservados.
            </div>
        </div>
    </div>
</body>
</html>