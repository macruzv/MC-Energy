@model OCPP.Core.Database.Role
@{
    ViewData["Title"] = "Crear Nuevo Rol";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 rounded-lg shadow-lg" style="background-color: #2b2d31;">
                <div class="card-body p-4">
                    <h3 class="text-white mb-4">Crear Nuevo Rol</h3>
                    <form asp-action="Create" method="post">
                        <div class="form-group mb-4">
                            <label class="text-muted small uppercase font-weight-bold">Nombre del Rol</label>
                            <input asp-for="Name" class="form-control bg-dark border-0 text-white" placeholder="ej: Operador" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary-md flex-grow-1 py-2">
                                <i class="fas fa-save mr-2"></i>Guardar Rol
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light py-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
