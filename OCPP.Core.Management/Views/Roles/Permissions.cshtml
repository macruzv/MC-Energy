@model OCPP.Core.Database.Role
@{
    ViewData["Title"] = "Configurar Permisos - " + Model.Name;
    var allPermissions = ViewBag.AllPermissions as List<OCPP.Core.Database.Permission>;
    var assignedIds = ViewBag.AssignedPermissionIds as List<int>;
}

<div class="container-fluid py-4">
    <div class="glass-panel p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <div>
                <h2 class="text-white h4 mb-1">
                    <i class="fas fa-lock-open mr-2 text-primary-md"></i>Permisos para: @Model.Name
                </h2>
                <p class="text-muted small mb-0">Seleccione los módulos y vistas que este rol tiene permitido acceder.</p>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-light btn-sm">
                <i class="fas fa-arrow-left mr-1"></i> Volver
            </a>
        </div>

        <form asp-action="SavePermissions" method="post">
            <input type="hidden" name="roleId" value="@Model.RoleId" />
            
            <div class="row">
                @foreach (var permission in allPermissions)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card bg-dark-light border-0 rounded-lg p-3 h-100 selection-card @(assignedIds.Contains(permission.PermissionId) ? "checked" : "")" onclick="toggleCheckbox(this)">
                            <div class="custom-control custom-switch custom-switch-lg">
                                <input type="checkbox" name="permissionIds" value="@permission.PermissionId" 
                                       class="custom-control-input" id="p_@permission.PermissionId"
                                       @(assignedIds.Contains(permission.PermissionId) ? "checked" : "")>
                                <label class="custom-control-label text-white font-weight-bold h5 mb-0 ml-4 pt-1" for="p_@permission.PermissionId" style="line-height: 1.5rem;">
                                    @permission.Name
                                </label>
                            </div>
                            <div class="mt-3 text-muted" style="font-size: 0.95rem;">
                                @if (!string.IsNullOrEmpty(permission.Description))
                                {
                                    <div class="mb-2 text-primary-md"><i class="fas fa-info-circle mr-1"></i> @permission.Description</div>
                                }
                                <div style="opacity: 0.7;"><i class="fas fa-code mr-1"></i> @permission.Controller / @permission.Action</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 text-right">
                <button type="submit" class="btn btn-primary-md btn-lg px-5 shadow">
                    <i class="fas fa-save mr-2"></i>GUARDAR CONFIGURACIÓN
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleCheckbox(card) {
        const checkbox = card.querySelector('input[type="checkbox"]');
        checkbox.checked = !checkbox.checked;
        if (checkbox.checked) {
            card.classList.add('checked');
        } else {
            card.classList.remove('checked');
        }
    }
    
    // Evitar que el click en el checkbox/label dispare doble evento
    document.querySelectorAll('.custom-control').forEach(ctrl => {
        ctrl.onclick = (e) => e.stopPropagation();
    });
</script>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
    }
    .bg-dark-light {
        background-color: rgba(255, 255, 255, 0.03);
        transition: all 0.2s ease;
        cursor: pointer;
        border: 1px solid transparent !important;
    }
    .bg-dark-light:hover {
        background-color: rgba(255, 255, 255, 0.08);
        transform: translateY(-2px);
    }
    .bg-dark-light.checked {
        background-color: rgba(187, 134, 252, 0.1);
        border: 1px solid rgba(187, 134, 252, 0.3) !important;
    }
    .btn-primary-md {
        background: #bb86fc;
        color: #000;
        font-weight: 700;
        border: none;
    }
    .text-primary-md {
        color: #bb86fc;
    }
    .custom-switch-lg .custom-control-label::before {
        height: 1.5rem;
        width: 2.5rem;
        border-radius: 1rem;
    }
    .custom-switch-lg .custom-control-label::after {
        width: calc(1.5rem - 4px);
        height: calc(1.5rem - 4px);
        border-radius: 1rem;
    }
    .custom-switch-lg .custom-control-input:checked ~ .custom-control-label::after {
        transform: translateX(1rem);
    }
</style>
